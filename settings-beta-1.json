{
  "timezone": "America/Argentina/Buenos_Aires",
  "bounds": {
    "minx": -110.0,
    "miny": -60.0,
    "maxx": -30.0,
    "maxy": -15.0
  },
  "metrics": {
    "enabled": true,
    "max_rows": 1000000
  },
  "scheduler": {
    "discovery_cron": "*/5 * * * *"
  },
  "sources": {
    "goes19-abi": {
      "input": { "mode": "s3", "s3_bucket": "noaa-goes19" },
      "products": { "c13": true, "c09": true, "c02": false },
      "target_images": 24,
      "max_hours_back": 5,
      "zoom_levels": "3-7",
      "retention_days": 1
    },
    "goes19-glm": {
      "input": { "mode": "local", "dir": "/app/data/glm_h5" },
      "products": { "fed": true, "toe": false, "mfa": false },
      "target_windows": 24,
      "accum_minutes": 10,
      "produce_every_minutes": 10,
      "safety_lag_seconds": 30,
      "zoom_levels": "3-7",
      "retention_days": 1
    },
    "radar-sinarame": {
      "input": { "mode": "local", "dir": "/app/data/radar_h5" },
      "products": {
        "dbzh": true,
        "dbzh-450km": true,
        "zdr": true,
        "rhohv": true,
        "kdp": true,
        "vrad": true
      },
      "stations": { "whitelist": ["RMA1", "RMA2", "RMA8"] },
      "target_images": 12,
      "zoom_levels": "4-9",
      "light_queue": "all",
      "retention_days": 1
    },
    "wrf-arg4k": {
      "input": { "mode": "local", "dir": "/app/data/wrf_nc" },
      "products": {
        "colmax": true,
        "rafagas": true,
        "campo-900hpa": false,
        "precipitacion-1h": false,
        "mucape": false,
        "agua-precipitable": false,
        "jet-capas-bajas": false,
        "cortante-niveles-bajos": false,
        "cape-brn": false,
        "granizo": false
      },
      "target_runs": 3,
      "zoom_levels": "4-6",
      "barb_zoom_strides": { "2": 150, "4": 38, "6": 16, "8": 9 },
      "light_queue": "all",
      "retention_days": 2
    },
    "ecmwf-ifs": {
      "input": { "mode": "opendata" },
      "products": { "total-precipitation": true, "mean-sea-level-pressure": false },
      "mean-sea-level-pressure": { "isobar_simplify_tolerance": 0.05, "smoothing_sigma": 1.5 },
      "zoom_levels": "3-7",
      "retention_days": { "default": 2, "grib": 1 }
    },
    "gfs": {
      "input": { "mode": "nomads" },
      "products": { "mean-sea-level-pressure": true, "geopotential-500hpa": false, "geopotential-250hpa": false },
      "cycles_to_maintain": 3,
      "max_steps_per_tick": 12,
      "availability_probe_hours": { "from": 3, "to": 8 },
      "smoothing_sigma": 1.5,
      "isoline_simplify_tolerance": 0.05,
      "zoom_levels": "3-7",
      "barb_zoom_strides": { "2": 24, "4": 7, "6": 3, "8": 2 },
      "http_timeout_seconds": 120,
      "max_concurrent_downloads": 2,
      "retention_days": 1
    }
  }
}
