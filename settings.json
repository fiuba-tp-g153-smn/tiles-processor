{
  "timezone": "America/Argentina/Buenos_Aires",
  "bounds": {
    "minx": -110.0,
    "miny": -60.0,
    "maxx": -30.0,
    "maxy": -15.0
  },
  "metrics": {
    "enabled": true,
    "max_rows": 1000000
  },
  "scheduler": {
    "discovery_cron": "*/5 * * * *"
  },
  "sources": {
    "goes19-abi": {
      "input": { "mode": "s3", "s3_bucket": "s3://noaa-goes19" },
      "products": { "c13": true, "c09": true, "c02": true },
      "target_images": 24,
      "max_hours_back": 5,
      "zoom_levels": "3-7",
      "retention_days": 1
    },
    "goes19-glm": {
      "input": { "mode": "local", "dir": "/app/data/glm_h5" },
      "accum_minutes": 10,
      "produce_every_minutes": 10,
      "safety_lag_seconds": 30,
      "target_windows": 24,
      "products": { "fed": true, "toe": true, "mfa": true },
      "zoom_levels": "3-7",
      "retention_days": 1
    },
    "radar-sinarame": {
      "input": { "mode": "local", "dir": "/app/data/radar_h5" },
      "stations": "all",
      "products": {
        "dbzh": true,
        "dbzh-450km": true,
        "zdr": true,
        "rhohv": true,
        "kdp": true,
        "vrad": true,
        "zh": false,
        "th": false,
        "wrad": false,
        "phidp": false
      },
      "target_images": 12,
      "zoom_levels": "4-9",
      "light_queue": "all",
      "retention_days": 1
    },
    "wrf-arg4k": {
      "input": { "mode": "local", "dir": "/app/data/wrf_nc" },
      "products": {
        "colmax": true,
        "rafagas": true,
        "campo-900hpa": true,
        "precipitacion-1h": true,
        "mucape": true,
        "agua-precipitable": true,
        "jet-capas-bajas": true,
        "cortante-niveles-bajos": true,
        "cape-brn": true,
        "granizo": true
      },
      "target_runs": 3,
      "zoom_levels": "4-6",
      "barb_zoom_strides": { "2": 150, "4": 38, "6": 16, "8": 9 },
      "light_queue": "all",
      "retention_days": 2
    },
    "ecmwf": {
      "products": {
        "precipitation": true,
        "mean_sea_level_pressure": true
      },
      "mslp": {
        "isobar_simplify_tolerance": 0.05,
        "smoothing_sigma": 1.5
      },
      "zoom_levels": "3-7",
      "retention_days": { "default": 2, "grib": 1 }
    },
    "gfs": {
      "products": { "mslp": true, "500": true, "250": true },
      "cycles_to_maintain": 3,
      "max_steps_per_tick": 12,
      "availability_probe_hours": { "from": 3, "to": 8 },
      "smoothing_sigma": 1.5,
      "isoline_simplify_tolerance": 0.05,
      "http_timeout_seconds": 120,
      "max_concurrent_downloads": 2,
      "zoom_levels": "3-7",
      "barb_zoom_strides": { "2": 24, "4": 7, "6": 3, "8": 2 },
      "retention_days": 1
    }
  }
}
