LOG_LEVEL=INFO

DATA_DIR=/app/data

# Ports
S3_TILES_DATA_PORT=9000

# S3 Root Configuration (Internal Admin)
S3_ROOT_USER=root_admin
S3_ROOT_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# S3 Tiles Data Configuration
S3_TILES_DATA_ENDPOINT=seaweedfs:8333
S3_TILES_DATA_BUCKET_NAME=tiles-data
S3_TILES_DATA_SECURE=false
# Max concurrent uploads per S3 client (tiles/COG/GRIB); also sizes the pool.
S3_UPLOAD_CONCURRENCY=32

# Work units a worker processes concurrently (overlaps a unit's upload tail with
# the next unit's compute). Total concurrent PUTs ≈ workers × this × S3_UPLOAD_CONCURRENCY.
WORKER_CONCURRENCY=2

S3_TILES_DATA_TILES_PROCESSOR_USER=tiles_processor
S3_TILES_DATA_TILES_PROCESSOR_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
S3_TILES_DATA_DATA_SERVICE_USER=data_service
S3_TILES_DATA_DATA_SERVICE_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# S3 Intersection Data Configuration (alerts-service geojson layers)
S3_INTERSECTION_DATA_BUCKET_NAME=intersection-data
S3_INTERSECTION_DATA_ALERTS_SERVICE_USER=alerts_service
S3_INTERSECTION_DATA_ALERTS_SERVICE_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# S3 Basemap Data Configuration (basemap tiles)
S3_BASEMAP_BUCKET_NAME=basemap-tiles

# Input-bucket credentials, one pair per data source (used only when that
# source's `sources.<name>.input.mode` is "s3"). Left unset the bucket is read
# anonymously; setting only one half of a pair fails at startup.
GOES19_ABI_S3_ACCESS_KEY=
GOES19_ABI_S3_SECRET_KEY=
GOES19_GLM_S3_ACCESS_KEY=
GOES19_GLM_S3_SECRET_KEY=
RADAR_SINARAME_S3_ACCESS_KEY=
RADAR_SINARAME_S3_SECRET_KEY=
WRF_ARG4K_S3_ACCESS_KEY=
WRF_ARG4K_S3_SECRET_KEY=
ECMWF_IFS_S3_ACCESS_KEY=
ECMWF_IFS_S3_SECRET_KEY=
GFS_S3_ACCESS_KEY=
GFS_S3_SECRET_KEY=

# --- Where each source's files live on the host --------------------------------
# One variable per source, read by docker compose only. Compose mounts each onto
# /app/data/<source-name>, which is where the app already looks, so nothing is
# passed into the container and settings.json needs no `dir`.
#
# REQUIRED, and deliberately left commented: copying this file gives you a .env
# that will not start until you fill them in, with
#   "invalid spec: :/app/data/goes19-abi:ro: empty section between colons"
# naming the first one you missed. Shipping a placeholder path instead would
# start cleanly and read nothing, which looks exactly like a source with no new
# data. The paths below are only a shape to copy.
#
# Every source needs one whatever mode it is in: a source reading S3 or a
# provider ignores its mount, and having it there means switching that source to
# "local" in settings.json is the only edit. Absolute paths only, and each must
# exist — Docker creates a missing one as an empty directory. Takes effect on
# restart; no rebuild.
# GOES19_ABI_INPUT_DIR=/srv/tiles-processor/data/goes19-abi
# GOES19_GLM_INPUT_DIR=/srv/tiles-processor/data/goes19-glm
# RADAR_SINARAME_INPUT_DIR=/srv/tiles-processor/data/radar-sinarame
# WRF_ARG4K_INPUT_DIR=/srv/tiles-processor/data/wrf-arg4k
# ECMWF_IFS_INPUT_DIR=/srv/tiles-processor/data/ecmwf-ifs
# GFS_INPUT_DIR=/srv/tiles-processor/data/gfs
